# Copy to .env and fill in.

# LLM provider. Set ONE key. With no key the deterministic offline pipeline answers
# (same tools, retrieval and grounding).
# Any OpenAI-compatible API. Default: Groq free tier (key from https://console.groq.com/keys).
#   Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5:3b
#   xAI Grok:        LLM_BASE_URL=https://api.x.ai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = llm if LLM_API_KEY is set, else claude if ANTHROPIC_API_KEY is set, else offline.
# Force with: llm | claude | offline
AI_MODE=auto

# At least 32 random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRE_MINUTES=120

# DATABASE_URL=sqlite:///data/hospital.db
# true = canned /chat responses for UI work / demo fallback
MOCK_AI=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
CHAT_RATE=20/minute
LOGIN_RATE=5/minute

# Reranker cut-off for "not found" (see ai/eval/calibrate.py)
# RERANK_THRESHOLD=-3.0
